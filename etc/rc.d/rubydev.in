#!/bin/sh

# PROVIDE: rubydev
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="rubydev"
rcvar="rubydev_enable"

load_rc_config "$name"

: ${rubydev_enable:="NO"}
: ${rubydev_dir:="%%APPDIR%%"}
: ${rubydev_user:="www"}
: ${rubydev_bind:="127.0.0.1"}
: ${rubydev_port:="9292"}
: ${rubydev_workers:="1"}
: ${rubydev_env:="production"}
: ${rubydev_bundle:="%%PREFIX%%/bin/bundle"}
: ${rubydev_path:="%%PREFIX%%/bin:/sbin:/bin:/usr/sbin:/usr/bin"}
: ${rubydev_logfile:="/var/log/rubydev.log"}
: ${rubydev_db_dir:="/var/db/rubydev"}
: ${rubydev_db_password:=""}
: ${rubydev_github_pat:=""}
: ${rubydev_deepseek_key:=""}
: ${rubydev_session_secret:=""}

# Falcon host runs a supervisor (the pidfile process) that owns the
# listener and manages forked workers. SIGHUP triggers a blue-green
# restart: fresh workers boot, then old ones are drained gracefully.
pidfile="/var/run/${name}.pid"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
restart_cmd="${name}_restart"
reload_cmd="${name}_reload"

rubydev_start()
{
	rubydev_start_instance "$pidfile"
}

# Bring up one instance, writing its pid to $1. Split out from
# rubydev_start so a restart can start a second instance alongside the
# running one without the two fighting over one pidfile.
rubydev_start_instance()
{
	target=$1

	if [ -f "$target" ] && kill -0 "$(cat "$target")" 2>/dev/null; then
		echo "${name} is already running."
		return 1
	fi
	# A pidfile with no process behind it is left over from a crash or a
	# kill -9, and would otherwise refuse every future start. Clear it.
	rm -f "$target"

	if [ ! -d "$rubydev_dir" ]; then
		warn "${rubydev_dir} does not exist"
		return 1
	fi

	echo "Starting ${name}."
	cd "$rubydev_dir" || return 1
	export BUNDLE_GEMFILE="${rubydev_dir}/Gemfile"
	export RACK_ENV="$rubydev_env"
	export PATH="$rubydev_path"
	export RUBYDEV_BIND="$rubydev_bind"
	export RUBYDEV_PORT="$rubydev_port"
	export RUBYDEV_WORKERS="$rubydev_workers"
	[ -n "$rubydev_db_password" ] && export RUBYDEV_DB_PASSWORD="$rubydev_db_password"
	[ -n "$rubydev_github_pat" ] && export GITHUB_RUBYDEV_PAT="$rubydev_github_pat"
	[ -n "$rubydev_deepseek_key" ] && export DEEPSEEK_API_KEY="$rubydev_deepseek_key"
	[ -n "$rubydev_session_secret" ] && export SESSION_SECRET="$rubydev_session_secret"
	# Apply pending migrations against the PostgreSQL database, then start
	# the service. (PostgreSQL needs no local data dir or ownership steps.)
	"$rubydev_bundle" exec rake roda:llm:db:migrate || return 1
	/usr/sbin/daemon -f -p "$target" -t "$name" -u "$rubydev_user" -o "$rubydev_logfile" \
		"$rubydev_bundle" exec falcon host
}

rubydev_stop()
{
	if [ ! -f "$pidfile" ]; then
		echo "${name} is not running."
		return 0
	fi

	pid=$(cat "$pidfile")
	echo "Stopping ${name}."
	kill "$pid" 2>/dev/null

	# Wait for it to go. The controller drains its workers on TERM and the
	# listener is only released when the last of them is gone, so starting
	# again too soon would fail to bind the port - which is what a scripted
	# stop-then-start, with no human pause in the middle, would do.
	i=0
	while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done

	rm -f "$pidfile"
}

# A restart with no gap. A deploy can carry something a running process
# cannot pick up - a new gem revision in the bundle, a new falcon.rb, a new
# variable in this script - and a SIGHUP cannot help with any of it: it
# makes the controller fork fresh workers from the parent it already has,
# so the workers get the new application code but the parent keeps the Ruby
# it booted with.
#
# So the new instance is a new process, and the port is shared while both
# are up: the endpoint asks for SO_REUSEPORT, so two instances can bind
# it and the kernel hands each connection to one of them. The old instance
# answers the whole time. Once the new one is listening, the old is asked
# to stop, and it drains its workers on the way out.
#
# If the new instance cannot bind - the first deploy after SO_REUSEPORT was
# introduced, say, since a socket only shares a port with others that asked
# for the same - it exits, and the old instance is left exactly as it was.
rubydev_restart()
{
	if [ ! -f "$pidfile" ] || ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
		rm -f "$pidfile"
		rubydev_start
		return $?
	fi

	oldpid=$(cat "$pidfile")
	newpidfile="${pidfile}.new"
	before=$(rubydev_listeners)
	rm -f "$newpidfile"

	rubydev_start_instance "$newpidfile" || return 1

	# Wait for the new instance to be listening: it adds sockets on the
	# port, so a count above the one taken before the start is it having
	# bound alongside the old instance. The same loop catches it dying on
	# the way up, which is what a failed bind looks like.
	echo "Waiting for the new instance to listen."
	i=0
	while [ "$i" -lt 30 ]; do
		if [ ! -f "$newpidfile" ] || ! kill -0 "$(cat "$newpidfile")" 2>/dev/null; then
			echo "The new ${name} exited while starting; leaving the old one in place."
			rm -f "$newpidfile"
			return 1
		fi
		if [ "$(rubydev_listeners)" -gt "$before" ]; then
			break
		fi
		sleep 1
		i=$((i + 1))
	done

	if [ "$i" -ge 30 ]; then
		echo "The new ${name} never bound ${rubydev_bind}:${rubydev_port}; leaving the old one in place."
		kill "$(cat "$newpidfile")" 2>/dev/null
		rm -f "$newpidfile"
		return 1
	fi

	echo "Stopping the old ${name} (pid $oldpid)."
	kill "$oldpid" 2>/dev/null
	i=0
	while kill -0 "$oldpid" 2>/dev/null && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done

	mv "$newpidfile" "$pidfile"
}

# How many sockets are on the service's port, which is how many instances
# are listening on it.
rubydev_listeners()
{
	sockstat -4 -p "$rubydev_port" 2>/dev/null | grep -c 'LISTEN'
}

# The graceful path: SIGHUP makes Falcon's controller fork fresh workers
# from the newly deployed code, wait for them to become ready, then drain
# the old ones. The shared listener stays bound the whole time, so there is
# no 502 gap. Only application code is picked up. If the service isn't
# running, fall back to a plain start.
rubydev_reload()
{
	if [ ! -f "$pidfile" ] || ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
		rm -f "$pidfile"
		echo "Starting ${name}."
		rubydev_start
		return $?
	fi

	echo "Reloading ${name}."
	kill -HUP "$(cat "$pidfile")"
}

rubydev_status()
{
	if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
		echo "${name} is running as pid $(cat "$pidfile")."
	else
		echo "${name} is not running."
		return 1
	fi
}

run_rc_command "$1"
