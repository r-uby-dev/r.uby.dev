<main class="home-showcase">
  <a class="home-logo" href="/" aria-label="r.uby.dev home">
    <%= svg!("rubydev-workmark.svg") %>
  </a>

  <script src="/roda-llm/web-component.js?v=<%= Raven.asset_version("roda-llm/web-component.js") %>"></script>
  <agent-console agent="robert" prompt="&gt;" placeholder="Ready when you are">
    <div slot="placeholder">
      <%= render "partials/greeting" %>
    </div>
    <svg slot="reset-icon"
         class="console-reset-icon"
         viewBox="0 0 16 16"
         width="16" height="16"
         fill="currentColor"
         aria-hidden="true">
         <path d="M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM4.496 6.675l.66 6.6a.25.25 0 0 0 .249.225h5.19a.25.25 0 0 0 .249-.225l.66-6.6a.75.75 0 0 1 1.492.149l-.66 6.6A1.748 1.748 0 0 1 10.595 15h-5.19a1.75 1.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z"/>
    </svg>

    <img slot="tool.*.call-icon" src="/images/github.svg" alt="">
    <img slot="tool.*.return-icon" src="/images/github.svg" alt="">
    <span slot="tool.search_repositories.call">Searching repositories&hellip;</span>
    <span slot="tool.search_repositories.return">Searched repositories</span>
    <span slot="tool.search_code.call">Searching code&hellip;</span>
    <span slot="tool.search_code.return">Searched code</span>
    <span slot="tool.search_commits.call">Searching commits&hellip;</span>
    <span slot="tool.search_commits.return">Searched commits</span>
    <span slot="tool.search_issues.call">Searching issues&hellip;</span>
    <span slot="tool.search_issues.return">Searched issues</span>
    <span slot="tool.get_file_contents.call">Reading source code&hellip;</span>
    <span slot="tool.get_file_contents.return">Read source code</span>
    <span slot="tool.get_commit.call">Reading commit&hellip;</span>
    <span slot="tool.get_commit.return">Read commit</span>
    <span slot="tool.list_commits.call">Listing commits&hellip;</span>
    <span slot="tool.list_commits.return">Listed commits</span>
    <span slot="tool.list_branches.call">Listing branches&hellip;</span>
    <span slot="tool.list_branches.return">Listed branches</span>
    <span slot="tool.list_issues.call">Listing issues&hellip;</span>
    <span slot="tool.list_issues.return">Listed issues</span>
    <span slot="tool.list_pull_requests.call">Listing pull requests&hellip;</span>
    <span slot="tool.list_pull_requests.return">Listed pull requests</span>
    <span slot="tool.pull_request_read.call">Reading pull request&hellip;</span>
    <span slot="tool.pull_request_read.return">Read pull request</span>
    <span slot="tool.issue_read.call">Reading issue&hellip;</span>
    <span slot="tool.issue_read.return">Read issue</span>
  </agent-console>
  <p class="console-note">powered by <%= anchor!(name: "llm.rb", href: "https://github.com/r-uby-dev/llm#readme") %></p>

  <section class="home-contact">
    <h2 class="home-section-title">About</h2>
    <p>
      r.uby.dev is the home of
      <a target="_blank" href="https://github.com/r-uby-dev/llm#readme">llm.rb</a> and
      <a target="_blank" href="https://github.com/r-uby-dev/roda-llm#readme">roda-llm</a>.
      Both projects are designed to help you build agentic systems in Ruby, Rack, and Rails
      applications.
    </p>
  </section>

    <section class="home-contact">
    <h2 class="home-section-title">Screencast</h2>
    <p>
      llm.rb includes a builtin console that can be started via the
      <code>llm.rb</code> executable or at runtime via <code>agent.console</code>.
      The console requires optional, opt-in dependencies to be installed separately.
    </p>
<script src="https://asciinema.org/a/Ycf3UYfIUn0qGF1R.js" id="asciicast-Ycf3UYfIUn0qGF1R" async="true"></script>
  </section>

  <section class="home-contact">
    <h2 class="home-section-title">Projects</h2>
    <div class="project-grid">
      <a class="project-card" href="https://github.com/r-uby-dev/llm#readme" target="_blank" rel="noopener">
        <h3 class="project-name">llm.rb</h3>
        <p class="project-tagline">llm.rb is an advanced runtime for building agentic AI applications on CRuby.</p>
        <p class="project-meta"><span class="lang-dot lang-ruby"></span> ruby<span class="project-license">MIT</span></p>
      </a>

      <a class="project-card" href="https://github.com/r-uby-dev/roda-llm#readme" target="_blank" rel="noopener">
        <h3 class="project-name">roda-llm</h3>
        <p class="project-tagline">roda-llm provides a framework for deploying multiple llm.rb agents.</p>
        <p class="project-meta"><span class="lang-dot lang-ruby"></span> ruby<span class="project-license">MIT</span></p>
      </a>

      <a class="project-card" href="https://github.com/r-uby-dev/xchan.rb#readme" target="_blank" rel="noopener">
        <h3 class="project-name">xchan.rb</h3>
        <p class="project-tagline">xchan.rb is easy-to-use InterProcess Communication (IPC) library.</p>
        <p class="project-meta"><span class="lang-dot lang-ruby"></span> ruby<span class="project-license">MIT</span></p>
      </a>

      <a class="project-card" href="https://github.com/r-uby-dev/test-cmd.rb#readme" target="_blank" rel="noopener">
        <h3 class="project-name">test-cmd.rb</h3>
        <p class="project-tagline">test-cmd.rb provides Go-inspired command execution for Ruby.</p>
        <p class="project-meta"><span class="lang-dot lang-ruby"></span> ruby<span class="project-license">MIT</span></p>
      </a>

      <a class="project-card" href="https://github.com/r-uby-dev/r.uby.dev#readme" target="_blank" rel="noopener">
        <h3 class="project-name">r.uby.dev</h3>
        <p class="project-tagline">The source code for this website.</p>
        <p class="project-meta"><span class="lang-dot lang-ruby"></span> ruby<span class="project-license">MIT</span></p>
      </a>
    </div>
  </section>

</main>
